{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "8f26ae924dd544a785130d01cc415972",
    "m_Title": "Paint Texture",
    "m_Content": "We use this texture to modify the look of areas that have been painted. \n\nIt is triplanar mapped in object space to give us freedom to get creative with how other textures are unwrapped in the main atlas\n\nR = Albedo - Will be tinted with the color and then override the under laying albedo\nG = Bump map - Converted to a normal map and blended with the underlying normals\nB = Metalness - Overrides the underlying Metalness\nA = Smoothness - Overrides the underlying smoothness",
    "m_TextSize": 0,
    "m_Theme": 1,
    "m_Position": {
        "serializedVersion": "2",
        "x": -4566.0,
        "y": 802.0,
        "width": 480.0,
        "height": 160.0
    },
    "m_Group": {
        "m_Id": "a93b819804554806a600957a13042743"
    }
}

